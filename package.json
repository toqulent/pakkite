{
  "name": "pakkite",
  "productName": "pakkite",
  "version": "1.0.0",
  "description": "A packet monitor for Minecraft: Java Edition",
  "main": "src/index.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "echo \"No linting configured\"",
    "build-web": "cp html out/html; rm -r out/html/startPage;"
  },
  "author": {
    "name": "Heath Mitchell",
    "email": "heath.mitchell27@gmail.com"
  },
  "license": "MIT",
  "config": {
    "forge": {
      "packagerConfig": {},
      "makers": [
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "darwin",
            "linux",
            "win32"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron/rebuild": "^4.2.1",
    "electron": "^45.2.3"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "clusterize.js": "^1.0.0",
    "commander": "^12.1.0",
    "electron-localshortcut": "^3.2.1",
    "electron-store": "^8.2.0",
    "electron-unhandled": "^4.0.1",
    "electron-window-state": "^5.0.3",
    "escape-html": "^1.0.3",
    "minecraft-data": "^3.119.0",
    "minecraft-folder-path": "^1.1.0",
    "minecraft-protocol": "^1.68.0",
    "node-eval": "^2.0.0",
    "source-map-support": "^0.5.21"
  },
  "optionalDependencies": {
    "bufferutil": "^4.2.0",
    "utf-8-validate": "^6.0.6"
  }
}
